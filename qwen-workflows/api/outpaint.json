{
  "qwen_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "qwen_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "qwen_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    }
  },
  "qwen_cache": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": [
        "qwen_control_apply",
        0
      ],
      "device": "auto",
      "dtype": "default"
    }
  },
  "qwen_encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "qwen_clip",
        0
      ],
      "prompt": "A complete seamless extension of the scene in <image1>. Continue the scenery naturally. Continue the surrounding scenery, perspective, lighting, colors and textures naturally into the new canvas areas. The entire canvas is filled with scene content, without blank borders.",
      "negative_prompt": "",
      "resolution": 1024,
      "images.image_1": [
        "qwen_original",
        0
      ]
    }
  },
  "qwen_sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "qwen_cache",
        0
      ],
      "positive": [
        "qwen_encode",
        0
      ],
      "negative": [
        "qwen_encode",
        1
      ],
      "latent_image": [
        "qwen_latent",
        0
      ],
      "seed": 43,
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "qwen_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "qwen_sample",
        0
      ],
      "vae": [
        "qwen_vae",
        0
      ]
    }
  },
  "qwen_save": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": [
        "qwen_composite",
        0
      ],
      "filename_prefix": "ComfyFloatBar/Qwen21_Outpaint",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB"
    }
  },
  "qwen_original": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    }
  },
  "qwen_pad": {
    "class_type": "ImagePadForOutpaint",
    "inputs": {
      "image": [
        "qwen_original",
        0
      ],
      "left": 256,
      "top": 0,
      "right": 256,
      "bottom": 0,
      "feathering": 0
    }
  },
  "qwen_working_canvas": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "qwen_pad",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1,
      "resolution_steps": 32
    }
  },
  "qwen_working_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "qwen_working_canvas",
        0
      ]
    }
  },
  "qwen_latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": [
        "qwen_working_size",
        0
      ],
      "height": [
        "qwen_working_size",
        1
      ],
      "batch_size": 1
    }
  },
  "qwen_control_patch": {
    "class_type": "ModelPatchLoader",
    "inputs": {
      "name": "qwen_image_2.1_fun_controlnet_union_int8_convrot.safetensors"
    }
  },
  "qwen_control_apply": {
    "class_type": "ZImageFunControlnet",
    "inputs": {
      "model": [
        "qwen_model",
        0
      ],
      "model_patch": [
        "qwen_control_patch",
        0
      ],
      "vae": [
        "qwen_vae",
        0
      ],
      "strength": 1,
      "start_percent": 0,
      "end_percent": 1,
      "inpaint_image": [
        "qwen_pad",
        0
      ],
      "mask": [
        "qwen_pad",
        1
      ]
    }
  },
  "qwen_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "qwen_pad",
        0
      ]
    }
  },
  "qwen_resize": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "qwen_decode",
        0
      ],
      "width": [
        "qwen_size",
        0
      ],
      "height": [
        "qwen_size",
        1
      ],
      "upscale_method": "lanczos",
      "crop": "disabled"
    }
  },
  "qwen_composite": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "qwen_pad",
        0
      ],
      "source": [
        "qwen_resize",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "qwen_pad",
        1
      ]
    }
  }
}
